{
    "name": "swagger-apigen",
    "version": "3.1.2",
    "description": "Faster OpenAPI 2.X & 3.X → TypeScript code generator with pluggable Eta templates.",
    "keywords": [
        "codegen",
        "eta",
        "generator",
        "openapi",
        "swagger",
        "typescript"
    ],
    "license": "MIT",
    "files": [
        "dist",
        "examples",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/cjs/lib.cjs",
    "module": "./dist/esm/lib.js",
    "types": "./dist/esm/lib.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/lib.d.ts",
            "import": "./dist/esm/lib.js",
            "require": "./dist/cjs/lib.cjs"
        },
        "./templates/*": "./dist/templates/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rslib build",
        "dev": "rslib build --watch",
        "lint": "tsc --noEmit && oxlint",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc -b --force",
        "test": "vitest",
        "test-ci": "vitest run",
        "test-coverage": "vitest run --coverage",
        "prepublishOnly": "npm run test-ci && npm run build"
    },
    "dependencies": {
        "eta": "3.5.0",
        "yaml": "2.6.1"
    },
    "devDependencies": {
        "@rslib/core": "1.0.0",
        "@types/node": "26.4.1",
        "@vitest/coverage-v8": "5.0.0",
        "oxfmt": "0.66.0",
        "oxlint": "1.79.0",
        "typescript": "7.0.2",
        "vitest": "5.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}
