{
    "extends": "../.config/tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "../.ts-cache/apigen",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": false,
        "composite": true,
        "allowImportingTsExtensions": true,
        "types": ["node"],
        "lib": ["ES2023"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "../.ts-cache"]
}
